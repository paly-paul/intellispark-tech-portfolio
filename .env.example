# Copy this file to .env.local and fill in real values.
# In Vercel: Project → Settings → Environment Variables (add each key below).

# Google Analytics 4 — analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ZDYY6NTGQ5

# Gmail SMTP (transactional email) — sends via smtp.gmail.com using nodemailer's
# 'gmail' service. GMAIL_APP_PASSWORD is a 16-character App Password generated at
# Google Account → Security → 2-Step Verification → App Passwords (requires 2FA
# enabled on the account). Do NOT use the account's normal login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where "Book a Call" / contact form submissions and newsletter signups are delivered
ADMIN_NOTIFICATION_EMAIL=talkto@intellispark.tech

# Turso (libSQL — SQLite-compatible, serverless-friendly) — turso.tech dashboard →
# create a database → copy its URL and create an auth token. Leads/subscribers are
# still emailed even without this set, just not persisted to a queryable database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
